<Window x:Class="TestTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestTask"
        mc:Ignorable="d"
        Title="MainWindow" Height="381" Width="692">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="288*"/>
            <RowDefinition Height="61*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="FileData" SelectionMode="Extended"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding}" Margin="10,10,10,5" Grid.ColumnSpan="5" CellEditEnding="FileData_CellEditEnding" PreviewMouseLeftButtonDown="FileData_PreviewMouseLeftButtonDown" >

            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя файла" Binding="{Binding Path = FileName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Контрольная сумма" Binding="{Binding Path = Checksum, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="True" Foreground="Gray"/>
                <DataGridTextColumn Header="Путь файла" Binding="{Binding Path = FilePath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
            
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FileData_PreviewMouseLeftButtonDown">
                    </EventSetter>
                </Style>
            </DataGrid.CellStyle>

        </DataGrid>
        <Button x:Name="ButtonAdd" Content="Добавить" Margin="10,10,10,12" Grid.Row="1" Click="AddFile_Click"/>
        <Button x:Name="ButtonSaveAs" Grid.Column="3" Content="Сохранить Как" Margin="10,10,10,12" Grid.Row="1" Click="SaveAsFile_Click"/>
        <Button x:Name="ButtonImport" Grid.Column="2" Content="Импорт" Margin="10,10,10,13" Grid.Row="1" Click="ImportFile_Click"/>
        <Button x:Name="ButtonDelete" Grid.Column="1" Content="Удалить строку(-и)" Margin="10,10,10,12" Grid.Row="1" Click="DeleteRow"/>
        <Button x:Name="ButtonSave" Grid.Column="4" Content="Сохранить" Margin="10,10,10,13" Grid.Row="1" Click="Save_Click"/>
    </Grid>
</Window>
