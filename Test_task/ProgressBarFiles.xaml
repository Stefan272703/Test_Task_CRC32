<Window x:Class="Test_Task.ProgressBarFiles"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test_Task"
        mc:Ignorable="d"
        Title="ProgressBarFiles" Height="131" Width="800">
    <Grid Margin="10,10,10,10">
        <ProgressBar x:Name="ProgressBar"  Margin="0,51,0,6" ValueChanged="ProgressBar_ValueChanged"/>
        <Label x:Name="TextFileName" Content="Label" Margin="0,10,0,0" VerticalAlignment="Top" Height="36"/>

    </Grid>
</Window>
